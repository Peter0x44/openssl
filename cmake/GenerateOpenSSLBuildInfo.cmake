cmake_minimum_required(VERSION 3.21)

foreach(_required_var OUTPUT_FILE COMPILER PLATFORM)
    if(NOT DEFINED ${_required_var} OR "${${_required_var}}" STREQUAL "")
        message(FATAL_ERROR "${_required_var} is required")
    endif()
endforeach()

string(TIMESTAMP _build_date "%b %d %Y" UTC)
string(REPLACE "\"" "\\\"" _compiler_escaped "${COMPILER}")
string(REPLACE "\"" "\\\"" _platform_escaped "${PLATFORM}")

set(_contents "/*\n")
string(APPEND _contents " * Generated by the OpenSSL CMake bootstrap.\n")
string(APPEND _contents " * Do not edit this file directly.\n")
string(APPEND _contents " */\n\n")
string(APPEND _contents "#ifndef OSSL_BUILDINF_H\n")
string(APPEND _contents "#define OSSL_BUILDINF_H\n\n")
string(APPEND _contents "#define DATE \"built on: ${_build_date}\"\n")
string(APPEND _contents "#define PLATFORM \"platform: ${_platform_escaped}\"\n")
string(APPEND _contents "static const char compiler_flags[] = \"compiler: ${_compiler_escaped}\";\n\n")
string(APPEND _contents "#endif /* OSSL_BUILDINF_H */\n")

get_filename_component(_output_dir "${OUTPUT_FILE}" DIRECTORY)
file(MAKE_DIRECTORY "${_output_dir}")
file(WRITE "${OUTPUT_FILE}" "${_contents}")
