    string(APPEND _text "#define lh_${type_name}_flush(lh) OPENSSL_LH_flush(ossl_check_${type_name}_lh_type(lh))\n")
    string(APPEND _text "#define lh_${type_name}_insert(lh, ptr) ((${type_name} *)OPENSSL_LH_insert(ossl_check_${type_name}_lh_type(lh), ossl_check_${type_name}_lh_plain_type(ptr)))\n")
    string(APPEND _text "#define lh_${type_name}_delete(lh, ptr) ((${type_name} *)OPENSSL_LH_delete(ossl_check_${type_name}_lh_type(lh), ossl_check_const_${type_name}_lh_plain_type(ptr)))\n")
    string(APPEND _text "#define lh_${type_name}_retrieve(lh, ptr) ((${type_name} *)OPENSSL_LH_retrieve(ossl_check_${type_name}_lh_type(lh), ossl_check_const_${type_name}_lh_plain_type(ptr)))\n")
    string(APPEND _text "#define lh_${type_name}_error(lh) OPENSSL_LH_error(ossl_check_${type_name}_lh_type(lh))\n")
