    string(APPEND _text "#define lh_${type_name}_node_usage_stats_bio(lh, out) OPENSSL_LH_node_usage_stats_bio(ossl_check_const_${type_name}_lh_type(lh), out)\n")
    string(APPEND _text "#define lh_${type_name}_stats_bio(lh, out) OPENSSL_LH_stats_bio(ossl_check_const_${type_name}_lh_type(lh), out)\n")
