cmake_minimum_required(VERSION 3.21)

foreach(_required_var OUTPUT_C OUTPUT_H SOURCE_FILES DISABLED_FEATURES)
    if(NOT DEFINED ${_required_var})
        message(FATAL_ERROR "${_required_var} is required")
    endif()
endforeach()

if(DEFINED SOURCE_FILES AND NOT SOURCE_FILES STREQUAL "")
    separate_arguments(_source_files NATIVE_COMMAND "${SOURCE_FILES}")
else()
    set(_source_files)
endif()

if(DEFINED DISABLED_FEATURES AND NOT DISABLED_FEATURES STREQUAL "")
    string(REPLACE ";" "|" _disabled_pattern "${DISABLED_FEATURES}")
else()
    set(_disabled_pattern "")
endif()

set(_commands)
foreach(_source IN LISTS _source_files)
    file(READ "${_source}" _source_text)
    string(REGEX MATCHALL "([a-z_][a-z0-9_]*)_main[ \t]*\\([ \t]*int[ \t]+argc[ \t]*," _matches "${_source_text}")
    foreach(_match IN LISTS _matches)
        string(REGEX REPLACE "^([a-z_][a-z0-9_]*)_main.*" "\\1" _command "${_match}")
        list(APPEND _commands "${_command}")
    endforeach()
endforeach()
list(REMOVE_DUPLICATES _commands)
list(SORT _commands)

string(TIMESTAMP _year "%Y" UTC)

set(_header "/*\n")
string(APPEND _header " * WARNING: do not edit!\n")
string(APPEND _header " * Generated by the OpenSSL CMake bootstrap.\n")
string(APPEND _header " *\n")
string(APPEND _header " * Copyright 1995-${_year} The OpenSSL Project Authors. All Rights Reserved.\n")
string(APPEND _header " */\n\n")
string(APPEND _header "#include \"function.h\"\n\n")
foreach(_command IN LISTS _commands)
    string(APPEND _header "extern int ${_command}_main(int argc, char *argv[]);\n")
endforeach()
string(APPEND _header "\n")
foreach(_command IN LISTS _commands)
    string(APPEND _header "extern const OPTIONS ${_command}_options[];\n")
endforeach()
string(APPEND _header "\nextern FUNCTION functions[];\n")

set(_body "/*\n")
string(APPEND _body " * WARNING: do not edit!\n")
string(APPEND _body " * Generated by the OpenSSL CMake bootstrap.\n")
string(APPEND _body " *\n")
string(APPEND _body " * Copyright 1995-${_year} The OpenSSL Project Authors. All Rights Reserved.\n")
string(APPEND _body " */\n\n")
string(APPEND _body "#include \"progs.h\"\n\n")
string(APPEND _body "FUNCTION functions[] = {\n")

foreach(_command IN LISTS _commands)
    set(_entry "    {FT_general, \"${_command}\", ${_command}_main, ${_command}_options, NULL, NULL},\n")
    if(_command MATCHES "^s_")
        string(APPEND _body "#ifndef OPENSSL_NO_SOCK\n${_entry}#endif\n")
    elseif(_disabled_pattern AND _command MATCHES "^(${_disabled_pattern})$")
        string(TOUPPER "${_command}" _guard)
        string(APPEND _body "#ifndef OPENSSL_NO_${_guard}\n${_entry}#endif\n")
    else()
        string(APPEND _body "${_entry}")
    endif()
endforeach()

foreach(_digest IN ITEMS md2 md4 md5 sha1 sha224 sha256 sha384 sha512 sha512-224 sha512-256 sha3-224 sha3-256 sha3-384 sha3-512 shake128 shake256 mdc2 rmd160 blake2b512 blake2s256 sm3)
    string(APPEND _body "    {FT_md, \"${_digest}\", dgst_main, NULL, NULL},\n")
endforeach()

foreach(_cipher IN ITEMS aes-128-cbc aes-128-ecb aes-192-cbc aes-192-ecb aes-256-cbc aes-256-ecb aria-128-cbc aria-128-cfb aria-128-ctr aria-128-ecb aria-128-ofb aria-128-cfb1 aria-128-cfb8 aria-192-cbc aria-192-cfb aria-192-ctr aria-192-ecb aria-192-ofb aria-192-cfb1 aria-192-cfb8 aria-256-cbc aria-256-cfb aria-256-ctr aria-256-ecb aria-256-ofb aria-256-cfb1 aria-256-cfb8 camellia-128-cbc camellia-128-ecb camellia-192-cbc camellia-192-ecb camellia-256-cbc camellia-256-ecb base64 zlib brotli zstd des des3 desx idea seed rc4 rc4-40 rc2 bf cast rc5 des-ecb des-ede des-ede3 des-cbc des-ede-cbc des-ede3-cbc des-cfb des-ede-cfb des-ede3-cfb des-ofb des-ede-ofb des-ede3-ofb idea-cbc idea-ecb idea-cfb idea-ofb seed-cbc seed-ecb seed-cfb seed-ofb rc2-cbc rc2-ecb rc2-cfb rc2-ofb rc2-64-cbc rc2-40-cbc bf-cbc bf-ecb bf-cfb bf-ofb cast5-cbc cast5-ecb cast5-cfb cast5-ofb cast-cbc rc5-cbc rc5-ecb rc5-cfb rc5-ofb sm4-cbc sm4-ecb sm4-cfb sm4-ofb sm4-ctr)
    string(APPEND _body "    {FT_cipher, \"${_cipher}\", enc_main, enc_options, NULL},\n")
endforeach()

string(APPEND _body "    {0, NULL, NULL, NULL, NULL}\n};\n")

get_filename_component(_header_dir "${OUTPUT_H}" DIRECTORY)
get_filename_component(_body_dir "${OUTPUT_C}" DIRECTORY)
file(MAKE_DIRECTORY "${_header_dir}")
file(MAKE_DIRECTORY "${_body_dir}")
file(WRITE "${OUTPUT_H}" "${_header}")
file(WRITE "${OUTPUT_C}" "${_body}")
